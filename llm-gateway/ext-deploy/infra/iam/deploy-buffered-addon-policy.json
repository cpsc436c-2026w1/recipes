{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployBufferedApiOnlyWhenChosen",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ca-central-1::/restapis",
        "arn:aws:apigateway:ca-central-1::/restapis/*"
      ]
    }
  ]
}
