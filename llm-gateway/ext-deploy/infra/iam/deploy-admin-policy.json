{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:ca-central-1:111122223333:stack/llm-gateway/*",
        "arn:aws:cloudformation:ca-central-1:111122223333:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:ca-central-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "DeployChangeSetsAnyStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SamManagedBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*"
      ]
    },
    {
      "Sid": "DeployFunction",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ca-central-1:111122223333:function:llm-gateway"
    },
    {
      "Sid": "ReadAdapterLayer",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:ca-central-1:753240598075:layer:LambdaAdapterLayerArm64:30"
    },
    {
      "Sid": "DeployTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:TagResource",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeContinuousBackups"
      ],
      "Resource": "arn:aws:dynamodb:ca-central-1:111122223333:table/llm-gateway-*"
    },
    {
      "Sid": "DeployTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:SetTopicAttributes",
        "sns:GetTopicAttributes",
        "sns:TagResource"
      ],
      "Resource": "arn:aws:sns:ca-central-1:111122223333:llm-gateway-alerts"
    },
    {
      "Sid": "DeployLogs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ca-central-1:111122223333:log-group:/aws/lambda/llm-gateway*"
    },
    {
      "Sid": "PassOnlyTheFunctionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/llm-gateway-fn",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AdminKeysAndUsage",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ca-central-1:111122223333:table/llm-gateway-keys",
        "arn:aws:dynamodb:ca-central-1:111122223333:table/llm-gateway-keys/index/by_key_id",
        "arn:aws:dynamodb:ca-central-1:111122223333:table/llm-gateway-usage",
        "arn:aws:dynamodb:ca-central-1:111122223333:table/llm-gateway-texts"
      ]
    },
    {
      "Sid": "AdminSubscriptions",
      "Effect": "Allow",
      "Action": [
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": "arn:aws:sns:ca-central-1:111122223333:llm-gateway-alerts"
    },
    {
      "Sid": "AdminKillSwitch",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:GetFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:ca-central-1:111122223333:function:llm-gateway"
    },
    {
      "Sid": "NoEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
