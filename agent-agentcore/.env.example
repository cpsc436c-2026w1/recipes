# Settings of this recipe. Copy to .env (cp .env.example .env), fill in the empty lines you need, and run with
# `uv run --env-file .env ...`. Offline commands run on this file as it is: `uv run --env-file .env.example ...`.
# ── 1. Course-wide ──
# AWS Region of the team sandbox. Source: course constraint (AGENTS.md). Change: outside the course.
AWS_REGION=ca-central-1
# AWS CLI and SDK profile. Leave commented out for the default credential chain. Source: AWS SDKs reference.
# AWS_PROFILE=your-profile
# First part of every resource name. Source: course constraint. Change: one per teammate in a shared account.
PREFIX=recipe
# Address of the course LLM gateway, ending in /v1. Source: the fuller .env in your team repository.
COURSE_GATEWAY_URL=
# ── 2. This recipe ──
# Model the agent calls on the course LLM gateway. Source: the L18 demo ran this agent on it. Change: another model on the gateway.
AGENT_MODEL=qwen3.8-27b
# Most model calls one member request may make. Source: assumed (a reply needs one call more than the tool calls it reads). Change: longer tasks.
MAX_MODEL_CALLS=8
# Most tool calls one member request may make. Source: assumed (two searches, one look-up, one write, two spare). Change: longer tasks.
MAX_TOOL_CALLS=6
# Seconds one member request may run before the next model call is cancelled. Source: assumed. Change: slower models.
DEADLINE_S=120
# Most tokens in one reply of the LLM. Source: assumed (the model's reasoning counts toward it). Change: longer replies.
REPLY_MAX_TOKENS=3000
# Seconds an idle Runtime session keeps its microVM. Source: assumed (time for a person to answer). AWS default is 900. Change: slower approvals.
RUNTIME_IDLE_TIMEOUT_S=300
# Seconds a Runtime session's microVM may live. Source: assumed. AWS default is 28800. Change: longer conversations.
RUNTIME_MAX_LIFETIME_S=1800
# Role of the tools Lambda function. Empty: the recipe creates one and clean_up.py removes it. Set: your role is used and left alone.
LAMBDA_ROLE_ARN=
# Role the Gateway uses to invoke the function. Empty: the recipe creates one. Set: your role is used and left alone.
GATEWAY_ROLE_ARN=
# Role the Runtime runs the agent with. Empty: the recipe creates one. Set: your role is used and left alone.
RUNTIME_ROLE_ARN=
# Send traces to Logfire: true or false. Source: course stack decision (off unless you turn it on). Change: when you want to see a request's spans.
LOGFIRE_ENABLED=false
# ── 3. Secrets (never commit values; the deploy step copies them to Parameter Store for the Runtime) ──
# Your course MCP token; the key for the course LLM gateway. Source: course page.
KB_MCP_TOKEN=
# Write token of your Logfire project. Empty: spans stay on this machine. Source: your Logfire project settings.
LOGFIRE_TOKEN=
