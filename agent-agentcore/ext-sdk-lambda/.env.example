# Settings of ext-sdk-lambda. Copy to ext-sdk-lambda/.env, fill in the empty lines you need, and run with
# `uv run --env-file ext-sdk-lambda/.env ...` from the recipe folder. Offline commands run on this file as it is.
# ── 1. Course-wide ──
# AWS Region of the team sandbox. Source: course constraint (AGENTS.md). Change: outside the course.
AWS_REGION=ca-central-1
# First part of every resource name. Source: course constraint. Change: one per teammate in a shared account.
PREFIX=recipe
# Address of the course LLM gateway, ending in /v1. Source: the fuller .env in your team repository.
COURSE_GATEWAY_URL=
# ── 2. This extension ──
# Which SDK runs the loop: strands or pydantic-ai. Source: the two SDKs teams were asked to choose from. Change: your SDK.
AGENT_SDK=strands
# Model the agent calls on the course LLM gateway. Source: the model of the eval trip-questions. Change: another gateway model.
AGENT_MODEL=qwen3.6-35b-a3b
# Most model calls one question may make. Source: assumed (3 queries and the answer). Change: questions that need more queries.
MAX_MODEL_CALLS=4
# Most run_sql calls one question may make. Source: assumed (the comparison of three zones). Change: as above.
MAX_TOOL_CALLS=3
# Seconds from the question's start after which nothing more starts and what runs is cancelled. Source: assumed (under the 30 s p95 target). Change: slower models.
DEADLINE_S=25
# Seconds one model call may take. Source: assumed. Change: slower models, with DEADLINE_S.
CALL_TIMEOUT_S=15
# Most tokens in one reply of the LLM, reasoning included. Source: the course gateway's per-key cap, 16,384 (llm-gateway
# ext-deploy); the live run used it, and no question used more than 206 output tokens. Change: a key with a lower cap.
REPLY_MAX_TOKENS=16384
# The day's trips. Relative paths are read beside handler.py (the function's package). Source: make_trips.py. Change: your data.
TRIPS_PATH=../build/trips.parquet
# Name of the Parameter Store parameter with the token, set by deploy.py in the function. Empty on a laptop: KB_MCP_TOKEN is used.
KB_MCP_TOKEN_PARAM=
# ── 3. Secrets (never commit values; deploy.py copies the token to Parameter Store) ──
# Your course MCP token; the key for the course LLM gateway. Source: course page.
KB_MCP_TOKEN=
